# Public Supabase config (the anon key is safe to expose; RLS protects data).
# NEVER put the service-role key in the frontend.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Leave empty in development (Vite proxies /api). Set to the deployed backend URL in production.
VITE_API_URL=
